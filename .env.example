# HolinSeek — modelo de configuração.
# Copie para .env e preencha. O arquivo .env NUNCA é versionado (ver .gitignore).
#
#   cp .env.example .env
#
# Todos os campos têm valor padrão: o pipeline roda sem editar nada, usando
# apenas dados locais. As chaves abaixo liberam downloads e recursos extras.

# ---------------------------------------------------------------------------
# NCBI / Entrez
# ---------------------------------------------------------------------------
# O NCBI exige um e-mail de contato em toda requisição programática.
# Sem ele, o download de genomas é recusado.
NCBI_EMAIL=voce@exemplo.org

# Opcional. Sem chave: 3 requisições por segundo. Com chave: 10 por segundo.
# Gere em https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# ---------------------------------------------------------------------------
# Diretórios de trabalho
# ---------------------------------------------------------------------------
HOLINSEEK_DATA_DIR=data
HOLINSEEK_RESULTS_DIR=data/results

# ---------------------------------------------------------------------------
# Critérios de triagem (os sete filtros do estudo)
# Altere aqui para afrouxar ou apertar a peneira sem mexer no código.
# ---------------------------------------------------------------------------
HOLINSEEK_MIN_LENGTH=50
HOLINSEEK_MAX_LENGTH=150
HOLINSEEK_MIN_TMD=1
HOLINSEEK_MAX_TMD=4
HOLINSEEK_MIN_GRAVY=0.4
HOLINSEEK_MIN_TAIL_CHARGE=3
HOLINSEEK_TM_WINDOW=19
HOLINSEEK_TM_THRESHOLD=1.6

# ---------------------------------------------------------------------------
# Camada de interpretação (opcional)
# ---------------------------------------------------------------------------
# O relatório de evidências é sempre gerado localmente, a partir dos números
# calculados pelo pipeline — isso não depende de nenhum serviço externo.
#
# Além dele, um modelo de linguagem pode redigir a leitura em prosa de cada
# candidato. Escolha o provedor:
#
#   none               desliga (padrão); só o relatório determinístico
#   anthropic          API da Anthropic (Claude)
#   openai_compatible  qualquer endpoint /chat/completions — outro serviço
#                      comercial ou um modelo aberto servido por você
#                      (Ollama, vLLM, llama.cpp, LM Studio...)
LLM_PROVIDER=none

# --- provedor: anthropic ---------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Profundidade do raciocínio: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# --- provedor: openai_compatible -------------------------------------------
# Exemplos de base: http://localhost:11434/v1  (Ollama)
#                   http://localhost:8000/v1   (vLLM)
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# --- comum aos dois --------------------------------------------------------
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4000
